{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
            "executable": "powershell.exe",
            "args": ["-NoProfile", "-Command"]
        }
    },
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake --preset msvc",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Ensure Configured",
            "type": "shell",
            "command": "if (-not (Test-Path -LiteralPath 'build/msvc/CMakeCache.txt')) { cmake --preset msvc }",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (RelWithDebInfo)",
            "type": "shell",
            "command": "cmake --build --preset relwithdebinfo",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake: Ensure Configured",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug",
            "group": "build",
            "dependsOn": "CMake: Ensure Configured",
            "problemMatcher": "$msCompile"
        }
    ]
}
